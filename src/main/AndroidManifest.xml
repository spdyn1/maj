<?xml version="1.0" encoding="utf-8"?>
<!-- fusionné dans le manifeste de l'appli : rien à déclarer de son côté -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- version.json et APK lus sur le site, APK installé -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <provider
            android:name="com.spdyn1.maj.MajFichiers"
            android:authorities="${applicationId}.maj"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/maj_fichiers" />
        </provider>
    </application>
</manifest>
